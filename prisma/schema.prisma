generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  OWNER
  AGENCY_MANAGER
  CLOSER
  SALES
  CHATTER_MANAGER
  CHATTER
  CONTENT_MANAGER
  EDITOR
  VIDEO_EDITOR
  ASSISTANT
  MODEL_ROLE
  FINANCE
  DEVELOPER
  VIEWER // legacy value, unused by any seeded/live row as of the 2026-07-23 migration; kept rather than dropped (Postgres has no cheap DROP VALUE) — do not assign to new users, not part of the MVP role set
}

enum Platform {
  INSTAGRAM
  YOUTUBE
  FACEBOOK
  PINTEREST
  THREADS
  TWITTER
  LINKEDIN
  TIKTOK
  BLUESKY
}

enum VideoStage {
  RAW
  A_EDITER
  EN_EDITION
  PRET_POUR_REVIEW
  VALIDE
  PROGRAMME
  PUBLIE
}

enum PostStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  PUBLISHED
  FAILED
}

enum ModelStatus {
  OK
  WARN
  CRIT
}

// Mirrors the "🟢 Activo / 🟡 En proceso / 🔴 Pausado" tri-state used
// throughout the real ClickUp "informacion personal (@{Nombre})" doc per
// model — the source of truth this phase imports from. Distinct from
// ModelStatus (content-pipeline health, unrelated concept).
enum ModelLifecycleStatus {
  ACTIVE
  IN_PROGRESS
  PAUSED
}

enum IntegrationType {
  GOOGLE_DRIVE
  GOOGLE_CALENDAR
  N8N
  BLOTATO
  TELEGRAM
  GOOGLE_SHEETS
  CUSTOM_API
  SOCIAL_ENGINE_NATIVE
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  COMING_SOON
}

enum ActivitySeverity {
  OK
  WARN
  CRIT
}

enum ActivityEventType {
  VIDEO_STAGE_CHANGED
  POST_SCHEDULED
  POST_PUBLISHED
  POST_FAILED
  MODEL_CREATED
  MODEL_CONTENT_LOW
  TEAM_MEMBER_ASSIGNED
  INTEGRATION_ERROR
  REPORT_GENERATED
  PLATFORM_CONNECTED
  PLATFORM_DISCONNECTED
  PLATFORM_TOKEN_EXPIRED
}

// Which system actually delivers a Model's posts for a given platform —
// lets Blotato and native adapters run side by side during the Social
// Engine migration (see src/engines/social/adapters/platformAdapter.ts).
enum SocialAccountSource {
  BLOTATO
  NATIVE
}

enum ReportFormat {
  PDF
  CSV
}

enum ReportStatus {
  PENDING
  READY
  FAILED
}

enum AgencyStatus {
  ACTIVE
  SUSPENDED
}

// Task Engine v0.1 — planning/persistence only, no execution transitions yet.
// Jarvis may currently only create tasks in PLANNED; the rest of the
// lifecycle is modeled so a future execution phase doesn't need a migration.
enum TaskStatus {
  PLANNED
  READY
  IN_PROGRESS
  BLOCKED
  WAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskSource {
  JARVIS
  HUMAN
  SYSTEM
}

// Approval Engine v0.1 — records a human decision, never executes anything.
// See docs/approval-engine.md.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

// Execution Engine v0.1 — see docs/execution-engine.md. Proves the
// infrastructure only: one test adapter workflow, no retries, no timeout
// sweep, no real business side effects.
enum ExecutionStatus {
  PENDING
  RUNNING
  AWAITING_CALLBACK
  SUCCEEDED
  FAILED
  TIMED_OUT
  CANCELLED
}

enum ExecutionStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

// Generic online/offline status shared by DeviceServer and Device — kept
// separate from ModelStatus/ActivitySeverity (OK/WARN/CRIT) because device
// connectivity is a different axis (reachable vs. content-health).
enum DeviceStatus {
  ONLINE
  OFFLINE
  DEGRADED
  DISABLED
  UNKNOWN
}

enum DeviceType {
  IPHONE
  ANDROID
  DESKTOP
  OTHER
}

// Generic system event log for device/account/agent/workflow lifecycle
// events — deliberately separate from ActivityLogEntry (which is the
// human-facing dashboard feed) since this is meant to be machine-oriented
// and open-ended (future device heartbeats, agent state changes, etc.).
enum SystemEventType {
  DEVICE_CONNECTED
  DEVICE_DISCONNECTED
  ACCOUNT_CONNECTED
  ACCOUNT_DISCONNECTED
  AGENT_ENABLED
  AGENT_DISABLED
  WORKFLOW_STARTED
  WORKFLOW_COMPLETED
  WORKFLOW_FAILED
  TASK_CREATED
  TASK_APPROVAL_REQUESTED
  TASK_APPROVED
  TASK_REJECTED
}

// ─────────────────────────────────────────────────────────────
// AGENCIES (multi-tenant boundary)
// ─────────────────────────────────────────────────────────────

model Agency {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    AgencyStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  teams               Team[]
  users               User[]
  models              Model[]
  videos              Video[]
  posts               Post[]
  activityLogEntries  ActivityLogEntry[]
  reports             Report[]
  integrations        Integration[]
  blotatoAccounts     BlotatoAccount[]
  platformConnections PlatformConnection[]
  mediaAssets         MediaAsset[]
  engineApiKeys       EngineApiKey[]
  deviceServers       DeviceServer[]
  devices             Device[]
  events              Event[]
  tasks               Task[]
  approvals           Approval[]
  executions          Execution[]

  @@index([slug])
}

// ─────────────────────────────────────────────────────────────
// AUTH / TEAM
// ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  role         Role     @default(ASSISTANT)
  avatarUrl    String?
  teamId       String?
  team         Team?    @relation(fields: [teamId], references: [id])
  agencyId     String? // NULL only for SUPER_ADMIN, who is not scoped to a single agency
  agency       Agency?  @relation(fields: [agencyId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts           Account[]
  sessions           Session[]
  assignedVideos     Video[]            @relation("VideoAssignedEditor")
  lastEditedVideos   Video[]            @relation("VideoLastEditedBy")
  activityLogEntries ActivityLogEntry[] @relation("ActivityActor")
  generatedReports   Report[]           @relation("ReportGeneratedBy")
  modelAssignments   ModelAssignment[]
  assignedDevices    Device[]           @relation("DeviceAssignedEmployee")
  requestedApprovals Approval[]         @relation("ApprovalRequestedBy")
  decidedApprovals   Approval[]         @relation("ApprovalDecidedBy")
  requestedExecutions Execution[]       @relation("ExecutionRequestedBy")

  @@index([teamId])
  @@index([agencyId])
}

// Standard NextAuth (Auth.js) Prisma adapter models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  members User[]
  models  Model[] @relation("ModelAssignedTeam")

  @@index([agencyId])
}

// ─────────────────────────────────────────────────────────────
// MODELS & BLOTATO ACCOUNTS
// ─────────────────────────────────────────────────────────────

model BlotatoAccount {
  id        String   @id @default(cuid())
  label     String
  apiKey    String // encrypted at rest (lib/crypto.ts), sent as `blotato-api-key` header
  capLimit  Int      @default(200) // ~200 concurrently-scheduled posts cap (real Blotato constraint)
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models         Model[]
  socialAccounts SocialAccount[]

  @@index([agencyId])
}

model Model {
  id               String          @id @default(cuid())
  name             String
  logoUrl          String?
  notes            String?         @db.Text
  status           ModelStatus     @default(OK)
  teamId           String?
  team             Team?           @relation("ModelAssignedTeam", fields: [teamId], references: [id])
  blotatoAccountId String?
  blotatoAccount   BlotatoAccount? @relation(fields: [blotatoAccountId], references: [id])
  accessCode       String?         @unique // model-portal login code (read-only self-service access)
  // Real Google Drive folder references (id only — never a full path, which
  // can be renamed without the id changing). driveFolderId is the model's
  // public intake folder (contains "1 — ONLYFANS"/"2 — NORMAL"/"3 — REELS"
  // subfolders where raw content is uploaded); driveInternalFolderId is the
  // internal mirror folder the assistant sorts content into for editing/
  // posting. Both nullable: linking a Model to its Drive folders is a
  // separate step from creating the Model, and older/test Models have none.
  driveFolderId         String?
  driveInternalFolderId String?

  // Real fields from the agency's existing ClickUp "informacion personal
  // (@{Nombre})" doc per model — replicating an already-in-use client
  // record, not inventing a new one. Every field is nullable: most are
  // still blank even in the real ClickUp docs today (confirmed by
  // inspection across all 9 models), so an empty field here is an honest
  // reflection of missing data, not a bug.
  legalName             String? // "Nombre completo"
  birthDate             DateTime? // "Fecha de nacimiento"
  stageName             String? // "Nombre artístico"
  personalEmail         String? // "Email"
  personalPhone         String? // "Teléfono"
  country               String? // "País"
  onboardingStartDate   DateTime? // "Fecha de inicio"
  relationshipStatus    ModelLifecycleStatus? // section 1 "Estado"
  managerName           String? // "Responsable / Manager asignado"
  importantNotes        String?               @db.Text // "Notas importantes"

  telegramHandle    String? // "Telegram del cliente"
  workGroupRef      String? // "Grupo de trabajo"
  vipChannelRef     String? // "Canal VIP"
  whatsapp          String? // "WhatsApp"
  directEmail       String? // "Email directo" — a separate field from personalEmail in the source doc

  contractUrl        String? // "Contrato" (Drive link, section 5)
  legalDocumentsUrl  String? // "Documentos legales" (Drive link, section 5)

  agencyCommissionPercent Float? // "Comisión de la agencia (%)"
  modelPercent            Float? // "Porcentaje del modelo (%)"
  paymentMethod           String? // "Método de pago"
  pendingAmount           Float? // "Dinero pendiente"
  paidAmountHistoric      Float? // "Dinero pagado (histórico)"
  contractStatus          ModelLifecycleStatus? // section 7 "Estado del contrato" — tracked separately from relationshipStatus since the source doc treats them as two distinct fields

  onboardingCompleted   Boolean? // "Onboarding" completado/no completado
  editorAssignedName    String? // "Editor asignado" (free-text name, not yet reconciled to a real User)
  chatterAssignedName   String? // "Chatter asignado"
  scripterAssignedName  String? // "Scripter asignado"
  nextTask              String? // "Próxima tarea"
  nextImportantDate     DateTime? // "Próxima fecha importante"

  generalNotes String? @db.Text // section 9 "Notas generales"

  agencyId         String
  agency           Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  socialAccounts      SocialAccount[]
  videos              Video[]
  activityLogEntries  ActivityLogEntry[]
  links               ModelLink[]
  assignments         ModelAssignment[]
  platformConnections PlatformConnection[]
  assignedDevices     Device[]

  @@index([blotatoAccountId])
  @@index([teamId])
  @@index([agencyId])
}

// Freeform links shown in the Model detail view (Notion-style) — a small
// child table rather than a JSON blob so individual rows can be added/removed
// independently without a read-modify-write race.
model ModelLink {
  id        String   @id @default(cuid())
  modelId   String
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  label     String
  url       String
  createdAt DateTime @default(now())

  @@index([modelId])
}

// "Who works on this Model" — deliberately no separate function-role field:
// the assigned User's own Role (Editor, Assistant, etc.) is what's displayed.
model ModelAssignment {
  id        String   @id @default(cuid())
  modelId   String
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([modelId, userId])
  @@index([modelId])
}

// A model's connection to one platform — either routed through a shared
// BlotatoAccount (legacy) or a native PlatformConnection (Social Engine).
// `source` says which one is authoritative; app-layer invariant (enforced in
// src/engines/social/services/socialConnection.service.ts, not a DB
// constraint): exactly one of blotatoAccountId/platformConnectionId is set,
// matching `source`. The @@unique([modelId, platform]) below is what actually
// prevents a Model from double-posting to the same platform during migration.
model SocialAccount {
  id                   String              @id @default(cuid())
  modelId              String
  model                Model               @relation(fields: [modelId], references: [id], onDelete: Cascade)
  source               SocialAccountSource @default(BLOTATO)
  blotatoAccountId     String?
  blotatoAccount       BlotatoAccount?     @relation(fields: [blotatoAccountId], references: [id])
  platformConnectionId String?             @unique
  platformConnection   PlatformConnection? @relation(fields: [platformConnectionId], references: [id])
  platform             Platform
  blotatoAccountRef    String? // Blotato's own per-platform accountId (target.accountId) — only set when source = BLOTATO
  displayName          String?
  isActive             Boolean             @default(true)
  // Optional link to the physical device this account is currently posting
  // from (e.g. an iPhone running Instagram) — null until device infrastructure
  // is actually assigned; posting itself is unaffected by this field today.
  assignedDeviceId     String?
  assignedDevice       Device?             @relation(fields: [assignedDeviceId], references: [id])
  createdAt            DateTime            @default(now())

  posts Post[]

  @@unique([modelId, platform])
  @@index([blotatoAccountId])
  @@index([assignedDeviceId])
}

// ─────────────────────────────────────────────────────────────
// SOCIAL ENGINE — native OAuth connections + stored media
// ─────────────────────────────────────────────────────────────

// A Model's native (non-Blotato) OAuth connection to one platform.
model PlatformConnection {
  id                String            @id @default(cuid())
  modelId           String
  model             Model             @relation(fields: [modelId], references: [id], onDelete: Cascade)
  platform          Platform
  externalAccountId String // the platform's own account/page id
  accessTokenEnc    String            @db.Text // AES-256-GCM via src/lib/crypto.ts
  refreshTokenEnc   String?           @db.Text
  tokenExpiresAt    DateTime?
  scopes            String[]
  status            IntegrationStatus @default(CONNECTED)
  lastError         String?           @db.Text
  agencyId          String
  agency            Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  socialAccount SocialAccount?

  @@unique([modelId, platform])
  @@index([agencyId])
  @@index([tokenExpiresAt])
}

// A media file the Social Engine has fetched off Google Drive and staged in
// object storage (src/lib/storage) — required for native uploads, since
// several platforms (YouTube in particular) have no "fetch from URL" option.
model MediaAsset {
  id          String   @id @default(cuid())
  videoId     String?
  video       Video?   @relation(fields: [videoId], references: [id])
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  storageKey  String
  mimeType    String
  sizeBytes   Int
  durationSec Int?
  checksum    String?
  createdAt   DateTime @default(now())

  @@index([videoId])
  @@index([agencyId])
}

// Bearer keys for engine-to-engine calls (future Agents layer, other
// Engines) against /api/engine/**. Not used for the dashboard's own
// session-cookie-authed Server Actions.
model EngineApiKey {
  id         String    @id @default(cuid())
  label      String
  hashedKey  String    @unique
  scopes     String[]
  agencyId   String? // null = cross-agency system key (used sparingly)
  agency     Agency?   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([agencyId])
}

// ─────────────────────────────────────────────────────────────
// CONTENT PIPELINE
// ─────────────────────────────────────────────────────────────

model Video {
  id               String     @id @default(cuid())
  title            String
  modelId          String
  model            Model      @relation(fields: [modelId], references: [id], onDelete: Cascade)
  stage            VideoStage @default(RAW)
  driveFileId      String?
  driveUrl         String?
  thumbnailUrl     String?
  caption          String?    @db.Text
  assignedEditorId String?
  assignedEditor   User?      @relation("VideoAssignedEditor", fields: [assignedEditorId], references: [id])
  lastEditedById   String?
  lastEditedBy     User?      @relation("VideoLastEditedBy", fields: [lastEditedById], references: [id])
  agencyId         String
  agency           Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  stageUpdatedAt   DateTime   @default(now())
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  posts       Post[]
  mediaAssets MediaAsset[]

  @@index([modelId, stage])
  @@index([assignedEditorId])
  @@index([agencyId])
}

// ─────────────────────────────────────────────────────────────
// POSTS (Blotato mapping)
// ─────────────────────────────────────────────────────────────

model Post {
  id              String        @id @default(cuid())
  videoId         String
  video           Video         @relation(fields: [videoId], references: [id], onDelete: Cascade)
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id])
  platform        Platform

  postSubmissionId String?    @unique
  status           PostStatus @default(PENDING)
  scheduledTime    DateTime
  publicUrl        String?
  errorMessage     String?    @db.Text
  requestPayload   Json?

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metricSnapshots PostMetricSnapshot[]

  @@index([socialAccountId])
  @@index([status, scheduledTime])
  @@index([platform, scheduledTime])
  @@index([agencyId])
}

// Append-only time-series, mirrors post-tracker/tracker.db `metrics` table
model PostMetricSnapshot {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  checkedAt DateTime @default(now())

  views      Int @default(0)
  likes      Int @default(0)
  comments   Int @default(0)
  saves      Int @default(0)
  shares     Int @default(0)
  reach      Int @default(0)
  engagement Int @default(0)

  @@index([postId, checkedAt])
}

// ─────────────────────────────────────────────────────────────
// ACTIVITY / INTEGRATIONS / REPORTS
// ─────────────────────────────────────────────────────────────

model ActivityLogEntry {
  id        String            @id @default(cuid())
  eventType ActivityEventType
  message   String
  severity  ActivitySeverity  @default(OK)
  modelId   String?
  model     Model?            @relation(fields: [modelId], references: [id])
  actorId   String?
  actor     User?             @relation("ActivityActor", fields: [actorId], references: [id])
  agencyId  String
  agency    Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([createdAt])
  @@index([modelId, createdAt])
  @@index([agencyId])
}

model Integration {
  id         String            @id @default(cuid())
  type       IntegrationType
  label      String
  status     IntegrationStatus @default(DISCONNECTED)
  lastSyncAt DateTime?
  lastError  String?           @db.Text
  configJson Json?
  agencyId   String
  agency     Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([agencyId, type])
}

model Report {
  id            String       @id @default(cuid())
  name          String
  format        ReportFormat
  status        ReportStatus @default(PENDING)
  fileUrl       String?
  sizeBytes     Int?
  generatedById String?
  generatedBy   User?        @relation("ReportGeneratedBy", fields: [generatedById], references: [id])
  agencyId      String
  agency        Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  paramsJson    Json?
  createdAt     DateTime     @default(now())
  completedAt   DateTime?

  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// DEVICE INFRASTRUCTURE (foundation only — no device-control commands,
// no credential storage, no automation. See docs/device-infrastructure.md
// for the architectural intent: a future physical machine at the agency's
// office/home that manages a pool of physical devices (iPhones, Android),
// reported here purely as inventory/status for BlackOS to read and assign.)
// ─────────────────────────────────────────────────────────────

model DeviceServer {
  id            String       @id @default(cuid())
  name          String
  hostname      String?
  status        DeviceStatus @default(UNKNOWN)
  location      String?
  lastHeartbeat DateTime?
  capabilities  Json? // freeform capability flags, e.g. { "maxDevices": 50 }
  agencyId      String
  agency        Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  devices Device[]
  events  Event[]

  @@index([agencyId])
  @@index([status])
}

model Device {
  id                 String       @id @default(cuid())
  deviceServerId     String
  deviceServer       DeviceServer @relation(fields: [deviceServerId], references: [id], onDelete: Cascade)
  name               String
  type               DeviceType   @default(OTHER)
  modelLabel         String? // manufacturer/model string, e.g. "iPhone 13 mini" — distinct from the `Model` entity below
  status             DeviceStatus @default(UNKNOWN)
  serialRef          String? // serial number or other physical reference — never a credential
  assignedModelId    String? // the talent/`Model` this device currently represents on social platforms
  assignedModel      Model?       @relation(fields: [assignedModelId], references: [id])
  assignedEmployeeId String? // the employee responsible for this device day-to-day
  assignedEmployee   User?        @relation("DeviceAssignedEmployee", fields: [assignedEmployeeId], references: [id])
  capabilities       Json?
  lastHeartbeat      DateTime?
  agencyId           String
  agency             Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  socialAccounts SocialAccount[]
  events         Event[]

  @@index([deviceServerId])
  @@index([assignedModelId])
  @@index([assignedEmployeeId])
  @@index([agencyId])
  @@index([status])
}

// Generic append-only event log for device/account/agent/workflow lifecycle
// — the machine-oriented counterpart to ActivityLogEntry. Nothing writes to
// this table yet; it exists so the shape is settled before any producer
// (device heartbeats, future Jarvis agents) is built.
model Event {
  id             String          @id @default(cuid())
  type           SystemEventType
  message        String?
  deviceServerId String?
  deviceServer   DeviceServer?   @relation(fields: [deviceServerId], references: [id])
  deviceId       String?
  device         Device?         @relation(fields: [deviceId], references: [id])
  metadata       Json?
  agencyId       String
  agency         Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())

  @@index([agencyId, createdAt])
  @@index([deviceServerId])
  @@index([deviceId])
}

// ─────────────────────────────────────────────────────────────
// TASK ENGINE v0.1 — planning/persistence only (see docs/task-engine.md).
// Jarvis's persistent representation of work: created only via
// src/jarvis/taskService.ts from an already-resolved Jarvis orchestration
// plan, never by guessing values independently. executionAllowed is always
// false in this phase — no execution transition exists yet.
// ─────────────────────────────────────────────────────────────

model Task {
  id        String       @id @default(cuid())
  agencyId  String
  agency    Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  title     String
  objective String       @db.Text
  status    TaskStatus   @default(PLANNED)
  priority  TaskPriority @default(NORMAL)
  source    TaskSource

  // Graph references (Neo4j is the source of truth for these — never
  // duplicated as Postgres foreign keys, see docs/task-engine.md).
  agentKey       String?
  capabilityKey  String?
  departmentKey  String?

  // Generic entity context — deliberately String/String rather than a
  // polymorphic Prisma relation (Model is the only supported entityType
  // in this phase; see docs/task-engine.md).
  entityType String?
  entityId   String?

  riskLevel        String? // "LOW" | "MEDIUM" | "HIGH", as resolved by Jarvis Core at planning time
  executionAllowed Boolean @default(false)

  // Future delegation (parent → child tasks) — data model only, no
  // automatic decomposition implemented yet.
  parentTaskId String?
  parentTask   Task?   @relation("TaskChildren", fields: [parentTaskId], references: [id])
  childTasks   Task[]  @relation("TaskChildren")

  // Placeholder for future request-level idempotency (see docs/task-engine.md
  // §13) — not yet enforced beyond the unique index below.
  requestId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvals  Approval[]
  executions Execution[]

  @@unique([agencyId, requestId])
  @@index([agencyId, status])
  @@index([parentTaskId])
  @@index([entityType, entityId])
}

// ─────────────────────────────────────────────────────────────
// APPROVAL ENGINE v0.1 — records a human decision only (see
// docs/approval-engine.md). Never triggers execution: there is no code path
// anywhere that reacts to Approval.status = APPROVED by calling n8n, an
// external API, or transitioning a Task into IN_PROGRESS/COMPLETED.
// One active PENDING approval per task is enforced at the database level —
// see the partial unique index added by hand in this model's migration
// (Prisma's schema language has no native partial-unique-index syntax).
// ─────────────────────────────────────────────────────────────

model Approval {
  id       String         @id @default(cuid())
  agencyId String
  agency   Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  taskId   String
  task     Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status   ApprovalStatus @default(PENDING)
  riskLevel String // snapshot of the risk level that triggered this approval, "LOW" | "MEDIUM" | "HIGH"

  requestedById String
  requestedBy   User   @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  decidedById   String?
  decidedBy     User?   @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])

  reason       String? @db.Text // why approval was required (from the centralized policy module)
  decisionNote String? @db.Text // optional note from the approver/rejecter

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  decidedAt DateTime?

  @@index([agencyId])
  @@index([taskId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// EXECUTION ENGINE v0.1 — see docs/execution-engine.md.
//
// One Execution = one attempt to carry out a Task that has reached READY
// (and, for HIGH risk, has an APPROVED Approval). Retries are new Execution
// rows (attempt+1), never a mutation of a prior row — keeps the audit trail
// intact. toolKey/workflowRef are snapshots resolved once at creation time
// from the Neo4j graph (src/jarvis/graphResolver.ts) — never re-resolved
// mid-flight, and never trusted from the caller.
//
// idempotencyKey is REQUIRED (unlike Task.requestId, which is optional) —
// Execution has real side effects, so it cannot afford the same honest gap.
// @@unique([taskId, idempotencyKey]) is the structural duplicate-execution
// guard; the partial-unique-index trick used for Approval isn't needed here
// since every Execution row participates in the constraint, not just a
// "PENDING" subset.
// ─────────────────────────────────────────────────────────────

model Execution {
  id       String          @id @default(cuid())
  agencyId String
  agency   Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  taskId   String
  task     Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status   ExecutionStatus @default(PENDING)

  toolKey     String // snapshot from Neo4j Tool.key at creation time, e.g. "n8n"
  workflowRef String // e.g. an n8n webhook path — resolved once, stored, never re-resolved mid-flight

  requestedById String
  requestedBy   User   @relation("ExecutionRequestedBy", fields: [requestedById], references: [id])

  idempotencyKey String // required — see model comment above
  attempt        Int    @default(1)

  startedAt    DateTime?
  finishedAt   DateTime?
  result       Json? // ExecutionResult shape: { success, summary, externalRef?, verifiedAt? }
  failureReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps ExecutionStep[]

  @@unique([taskId, idempotencyKey])
  @@index([agencyId])
  @@index([taskId])
  @@index([status])
}

// Exactly one ExecutionStep is created per Execution in v0.1 (kind:
// N8N_WORKFLOW, sequence: 1) — the shape supports multiple steps so a future
// multi-step execution phase doesn't need a schema change, but nothing
// creates more than one today.
model ExecutionStep {
  id          String              @id @default(cuid())
  executionId String
  execution   Execution           @relation(fields: [executionId], references: [id], onDelete: Cascade)
  sequence    Int
  kind        String // "N8N_WORKFLOW" today; other kinds are future work, not invented here
  status      ExecutionStepStatus @default(PENDING)
  input       Json?
  output      Json?

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([executionId, sequence])
  @@index([executionId])
}

// ─────────────────────────────────────────────────────────────
// JARVIS ORCHESTRATOR v0.1a — see docs/orchestrator.md.
//
// OrchestrationRecord is a thin coordination/index row: it tracks WHICH
// Task/Approval/Execution a given end-user request produced and what
// coordination state that request has reached. It deliberately does NOT
// duplicate any mutable state that Task/Approval/Execution already own
// (status, risk, result, etc.) — those tables remain the only source of
// truth for their own domain. Querying "is this done yet" always means
// joining out to the referenced Task/Approval/Execution, never reading a
// cached copy here.
//
// requestId is the idempotency key: @@unique([agencyId, requestId]) is the
// structural guard against a caller's retried/duplicated request creating a
// second orchestration — the same pattern as Task.requestId and
// Execution.idempotencyKey.
// ─────────────────────────────────────────────────────────────

enum OrchestrationState {
  REQUESTED
  PLANNING
  TASK_CREATED
  AWAITING_APPROVAL
  EXECUTING
  COMPLETED
  FAILED
  NEEDS_CLARIFICATION
  REJECTED
}

model OrchestrationRecord {
  id       String @id @default(cuid())
  agencyId String

  // Idempotency key — optional because a caller isn't required to supply one
  // (mirrors Task.requestId), but when present it is unique per agency.
  requestId String?

  state         OrchestrationState @default(REQUESTED)
  failureReason String?            @db.Text

  // References only — never a copy of the referenced row's mutable fields.
  taskId      String?
  approvalId  String?
  executionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agencyId, requestId])
  @@index([agencyId])
  @@index([taskId])
  @@index([approvalId])
  @@index([executionId])
}
