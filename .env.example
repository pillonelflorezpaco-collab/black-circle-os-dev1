# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/black_circle_os

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Encryption for stored Blotato API keys (BlotatoAccount.apiKey)
ENCRYPTION_KEY=

# Blotato
BLOTATO_BASE_URL=https://backend.blotato.com/v2

# Webhooks shared secret (n8n / Blotato inbound)
WEBHOOK_SHARED_SECRET=

# Telegram notifications (same bot pattern as the agency's n8n workflow)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=

# Google Calendar — shared "Black Circle" calendar, service account auth
# (share the calendar with GOOGLE_SERVICE_ACCOUNT_EMAIL as an editor)
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Postgres (docker-compose only)
POSTGRES_USER=black_circle
POSTGRES_PASSWORD=
POSTGRES_DB=black_circle_os

# Social Engine — object storage (S3-compatible: MinIO self-hosted, or Cloudflare R2)
# MinIO example: STORAGE_ENDPOINT=http://minio:9000, STORAGE_FORCE_PATH_STYLE=true
# R2 example:    STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com, STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_FORCE_PATH_STYLE=true
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=black-circle-media

# Social Engine — internal engine-to-engine API key (any random 32+ char string, generated once)
ENGINE_API_KEY_PEPPER=

# Social Engine — pg-boss uses the same DATABASE_URL, no separate config needed

# Jarvis Core — read-only organizational graph (Neo4j). Internal Docker
# network only (bolt://neo4j:7687), never exposed publicly.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Execution Engine v0.1 — internal Docker network only, never exposed publicly.
N8N_INTERNAL_URL=http://automation-stack-n8n-1:5678
