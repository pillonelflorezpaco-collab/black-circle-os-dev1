# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/black_circle_os

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Encryption for stored Blotato API keys (BlotatoAccount.apiKey)
ENCRYPTION_KEY=

# Blotato
BLOTATO_BASE_URL=https://backend.blotato.com/v2

# Webhooks shared secret (n8n / Blotato inbound)
WEBHOOK_SHARED_SECRET=

# Telegram notifications (same bot pattern as the agency's n8n workflow)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=

# Google Calendar — shared "Black Circle" calendar, service account auth
# (share the calendar with GOOGLE_SERVICE_ACCOUNT_EMAIL as an editor)
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Postgres (docker-compose only)
POSTGRES_USER=black_circle
POSTGRES_PASSWORD=
POSTGRES_DB=black_circle_os
